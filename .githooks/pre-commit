#!/usr/bin/env bash
# PalORM 预提交门禁——薄包装：转发到仓库内脚本，脚本更新即时生效（无拷贝漂移）。
# 安装: git config core.hooksPath .githooks
set -uo pipefail

echo "── pre-commit: secret-guard ──"
dotnet run --file "$(git rev-parse --show-toplevel)/scripts/secret-guard.cs" || exit 1

echo "── pre-commit: stub-check ──"
dotnet run --file "$(git rev-parse --show-toplevel)/scripts/stub-check.cs" || exit 1

# 参数集合复用纪律（R-UNNESTB，2026-10-02）：src/ 内每处 Parameters.Clear()/RemoveAt
# 必须在邻近声明理由码——PG auto-prepare 下「复用命令 + 换参数实例」会静默发旧值，
# 而 SQLite 套件对 PG 缺陷零判别力，只能机械化拦截。详见 docs/编码规范.md §20。
echo "── pre-commit: 参数集合复用门禁 ──"
dotnet run --file "$(git rev-parse --show-toplevel)/scripts/gate-param-collection-reuse.cs" || exit 1

# .ai 系统一致性（2026-09-25 起；2026-10-08 判定层 C# 化迁主仓 scripts/）：lessons/test 的
# "计数与标题声明"必须等于实测。这类漂移已发生过 3 次（lessons 标题停 v7.14、§II 声明
# 93/1-B86 实测 98、test 补充节标题停 8~12 实到 19），人工核不住，故机械化到每次提交。
# .ai/ 是 gitignored 本地工具，未克隆时无条件跳过（条件执行，不因缺文件报错）。
# --fast 只跑纯文本检查：跳过 V14（跑 10 条防线脚本会与并发测量互斥）与
# V17（变异探针会在 src/ 临时植入 .cs，与并发构建互斥）。
ROOT="$(git rev-parse --show-toplevel)"
if [ -d "$ROOT/.ai" ] && [ -f "$ROOT/scripts/verify-ai-system.cs" ]; then
    echo "── pre-commit: .ai 系统一致性（--fast）──"
    dotnet run --file "$ROOT/scripts/verify-ai-system.cs" -- --fast || exit 1
else
    echo "── pre-commit: .ai 系统一致性（跳过：无 .ai/）──"
fi

# G1-G33 门禁（2026-09-30 起）：verify V14 只验"跑到完成标记"不判 FAIL 项——
# G9 豁免清单漂移回归（secret-guard .sh→.cs 迁移漏同步）3 天无人发现，根因是
# gate-check 在 CI 与 pre-commit 均无触发点。--allow-dirty：提交瞬间 staged 变更
# 是预期状态，G33"跨任务切换前清洁"语义不适用本场景（脚本自带该参数）。
# C# 化后约 1-4 秒（bash 版 ~11 秒；git grep 全仓只读扫描，无构建副作用）。
if [ -d "$ROOT/.ai" ] && [ -f "$ROOT/scripts/gate-check.cs" ]; then
    echo "── pre-commit: G1-G33 门禁（--allow-dirty）──"
    dotnet run --file "$ROOT/scripts/gate-check.cs" -- --allow-dirty || exit 1
else
    echo "── pre-commit: G1-G33 门禁（跳过：无 .ai/）──"
fi

exit 0
