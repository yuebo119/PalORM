<Project>
  <PropertyGroup>
    <!-- 公共版本 -->
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- AOT 全链路安全 -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <!-- .NET 11 runtime-async：运行时原生异步（替换编译器状态机）。
         BCL 自 .NET 11 起已用 runtime-async=on 编译。
         net11.0 目标不再需要 EnablePreviewFeatures，但仍需显式开启此 Features 开关。
         收益：① ExecutionContext 空捕获跳过（项目 AsyncLocal 仅 2 个，绝大多数 await 受益）
              ② JIT 直接编译 runtime-async 版本（去掉 thunk 间接层）
              ③ 更干净堆栈跟踪（无状态机帧）—— WithTransaction / Bulk 调试可读性改善 -->
    <Features>runtime-async=on</Features>

    <!-- 严格编译 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NU1507: 中央包管理多源警告（NuGet.Config 双源 nuget.org + dotnet-tools，
         前者承载稳定包，后者承载 .NET SDK 预览版；不使用 packageSourceMapping 故触发 NU1507） -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>

    <!-- NuGet -->
    <Authors>PalDDD</Authors>
    <Copyright>© 2026 PalDDD</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- NuGet 包版本（中央管理，避免 6 个 src csproj 各自硬编码漂移）。
         只设 Version；FileVersion/AssemblyVersion 让 MSBuild 默认派生（避免补丁版强名称漂移）。 -->
    <Version>5.0.0</Version>

    <!-- NuGet.org 展示元数据（指向仓库与变更日志，包页可点击） -->
    <PackageProjectUrl>https://github.com/yuebo119/PalORM</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yuebo119/PalORM.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/yuebo119/PalORM/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- SourceLink：NuGet.org 包页显示源码链接，F12 可步入源码（现代实践标准）。
         EmbedUntrackedSources 把未跟踪源文件嵌入 PDB；PublishRepositoryUrl 把仓库 URL 写入 PDB。
         ContinuousIntegrationBuild 只在 CI 设 true（启用确定性构建+deterministic PDB），
         本地保持 false 避免锁定 DLL 时间戳影响调试。 -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- 源生成器产出不审计 -->
    <GeneratedFolder>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\generated\</GeneratedFolder>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

  <!-- 测试项目覆盖 -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: 测试代码非公共 API 面，不强制 XML 文档（src/ 全域强制） -->
    <NoWarn>$(NoWarn);CA2007;CA1062;CA1031;CS1591;S8969</NoWarn>
  </PropertyGroup>

  <!-- 测试支撑模型程序集（AotModels.*）：同测试项目，不强制 XML 文档 -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('PalORM.AotModels'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- 基准项目覆盖 -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: 基准代码非公共 API 面，不强制 XML 文档（src/ 全域强制） -->
    <!-- NETSDK1206: SQLitePCLRaw alpine RID 资产缺失——Benchmarks 仅本地跑性能对比，
         不发布 alpine 运行时，此警告无意义（与 src/ 发布库不同） -->
    <NoWarn>$(NoWarn);CA2007;CA1724;CA1822;IDE1006;IDE0060;CS1591;NETSDK1206</NoWarn>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <!-- 质量分析器（v3.0 引入）：
       SonarAnalyzer.CSharp 让 IDE SonarLint 报告与 CI 编译错误对齐。
       排除 SourceGen 项目——它运行在 netstandard2.0 + Roslyn 分析器上下文，SonarAnalyzer 不兼容。
       规则严重性在 .editorconfig 分层配置（P0 安全/正确性 → error，P1 设计 → warning，P2 风格 → suggestion）。-->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'PalORM.SourceGen' and '$(ManagePackageVersionsCentrally)' != 'false'">
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
