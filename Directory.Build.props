<Project>
  <PropertyGroup>
    <!-- 公共版本 -->
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- AOT 全链路安全 -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <!-- 严格编译 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NU1507: 中央包管理多源警告（NuGet.Config 单源，误报） -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>

    <!-- NuGet -->
    <Authors>PalDDD</Authors>
    <Copyright>© 2026 PalDDD</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- 源生成器产出不审计 -->
    <GeneratedFolder>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\generated\</GeneratedFolder>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

  <!-- 测试项目覆盖 -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: 测试代码非公共 API 面，不强制 XML 文档（src/ 全域强制） -->
    <NoWarn>$(NoWarn);CA2007;CA1062;CA1031;CS1591</NoWarn>
  </PropertyGroup>

  <!-- 测试支撑模型程序集（AotModels.*）：同测试项目，不强制 XML 文档 -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('PalORM.AotModels'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- 基准项目覆盖 -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: 基准代码非公共 API 面，不强制 XML 文档（src/ 全域强制） -->
    <NoWarn>$(NoWarn);CA2007;CA1724;CA1822;IDE1006;IDE0060;CS1591</NoWarn>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <!-- 质量分析器（v3.0 引入）：
       SonarAnalyzer.CSharp 让 IDE SonarLint 报告与 CI 编译错误对齐。
       排除 SourceGen 项目——它运行在 netstandard2.0 + Roslyn 分析器上下文，SonarAnalyzer 不兼容。
       规则严重性在 .editorconfig 分层配置（P0 安全/正确性 → error，P1 设计 → warning，P2 风格 → suggestion）。-->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'PalORM.SourceGen'">
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
