<Project>
  <PropertyGroup>
    <!-- 公共版本 -->
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- AOT 全链路安全 -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <!-- 严格编译 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- XML 文档警告：Phase 1 阶段渐进添加文档，暂不强制 -->
    <NoWarn>$(NoWarn);CS1591;NU1507</NoWarn>

    <!-- NuGet -->
    <Authors>PalDDD</Authors>
    <Copyright>© 2026 PalDDD</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- 源生成器产出不审计 -->
    <GeneratedFolder>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\generated\</GeneratedFolder>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

  <!-- 测试项目覆盖 -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA2007;CA1062;CA1031</NoWarn>
  </PropertyGroup>

  <!-- 基准项目覆盖 -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA2007;CA1724;CA1822;IDE1006;IDE0060</NoWarn>
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
