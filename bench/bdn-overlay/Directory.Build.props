<Project>
  <!-- v5.0 阶段 3.4：BDN fork 本地引用——禁用 PalORM 的中央包管理（CPM）+ 分析器严格配置。
       BDN 子项目用自己的 PackageReference Version + 较宽松的分析器配置，不接受 PalORM 的约束。 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <!-- PalORM 顶层 Directory.Build.props 设了 latest-all + TreatWarningsAsErrors=true，
         BDN fork 代码不符合这些严格规则，需重置。 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1849;CA1031;CA1416;CA1859;CA1310;CA1305;CA1054;CA1051;CA1001;CA1014;CA1062;CA1307;CA1311;CA1716;CA1822;CA1851;CA2007;CA2208;CA2211;SA1202;SA1201;SA1600;SA1101;SA1128;SA1200;SA1309;SA1310;SA1313;SA1401;SA1402;SA1413;SA1500;SA1502;SA1515;SA1516;CA1825;CA1827;CA1829;CA1860;CA1854;CA1848;CA1834;CA1820;CA1816;CA1819;CA1823;CA1830;CA2227;CA2231;CA2229;CA1056;CA1058;CA1052;CA1036;CA1034;CA1027;CA1024;CA1012;CA1000;CA1002;CA2225;CA2237;CA1810;CA1724;CA1720;CA1717;CA1715;CA1711;CA1710;CA1708;CA1707;CA1700;CA1508;CA1505;CA1502;CA1500;CA2201;CA2200;CA2100;CA2016;CA2015;CA2014;CA2012;CA2011;CA2009;CA2008;CA2002;CA2000;CA1805;CA1804;CA1802;CA1801;CA1800</NoWarn>
  </PropertyGroup>
  <!-- 不继承 PalORM 的 SonarAnalyzer（BDN fork 代码不符合 PalORM 规则） -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'PalORM.SourceGen'">
    <!-- 显式移除从父 Directory.Build.props 继承的 SonarAnalyzer -->
  </ItemGroup>
</Project>
