<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 程序集名保持 PalORM.PerfHub：PalormImpl 需要 internal DataSession ctor，
         Core 的 InternalsVisibleTo 按程序集名授权（与原开发副本同法；两工程互不引用不冲突） -->
    <AssemblyName>PalORM.PerfHub</AssemblyName>
    <RootNamespace>PalORM.PerfHub</RootNamespace>
    <!-- 仓内副本独立于根 CPM/分析器策略：基准夹具不是产品代码，直接版本引用 + 白名单 NoWarn
         （与 bench/PalORM.PerfHub 同口径；根 Directory.Build.props 的 IsAotCompatible/
         TreatWarningsAsErrors 在此显式关闭，避免基准代码被产品级门禁误伤） -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
    <NoWarn>$(NoWarn);CA2007;CA1062;CA1031;S107;CA2100;S2077;CA1303;CA1305;S1215;PALORM005;CA1849;S6966;CA2213;S3903;IDE0055;S3776;S3267;S1481;CA1502;CA1852;S1144;CA1515;CS1591;DAP043;DAP005;CA5394;S2245</NoWarn>
  </PropertyGroup>

  <!-- PerfHub 测量引擎与三臂实现以链接方式编译（单一事实源：交叉臂只新增 FreeSql 与 Runner） -->
  <ItemGroup>
    <Compile Include="..\..\PalORM.PerfHub\Dataset.cs" Link="PerfHub\Dataset.cs" />
    <Compile Include="..\..\PalORM.PerfHub\Implementations.cs" Link="PerfHub\Implementations.cs" />
    <Compile Include="..\..\PalORM.PerfHub\Measure.cs" Link="PerfHub\Measure.cs" />
    <Compile Include="..\..\PalORM.PerfHub\Counting.cs" Link="PerfHub\Counting.cs" />
    <Compile Include="..\..\PalORM.PerfHub\StageTiming.cs" Link="PerfHub\StageTiming.cs" />
    <Compile Include="..\..\PalORM.PerfHub\SampleDump.cs" Link="PerfHub\SampleDump.cs" />
    <Compile Include="..\..\PalORM.PerfHub\BenchTenantFixtures.cs" Link="PerfHub\BenchTenantFixtures.cs" />
    <Compile Include="..\..\PalORM.PerfHub\S1RowDataReader.cs" Link="PerfHub\S1RowDataReader.cs" />
    <Compile Include="..\..\shared\PerfTiming.cs" Link="Shared\PerfTiming.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\PalORM.Core\PalORM.Core.csproj" />
    <ProjectReference Include="..\..\..\src\PalORM.Sqlite\PalORM.Sqlite.csproj" />
    <ProjectReference Include="..\..\..\src\PalORM.PostgreSql\PalORM.PostgreSql.csproj" />
    <ProjectReference Include="..\..\..\src\PalORM.MySql\PalORM.MySql.csproj" />
    <ProjectReference Include="..\..\..\src\PalORM.Testing\PalORM.Testing.csproj" />
    <ProjectReference Include="..\..\..\src\PalORM.SourceGen\PalORM.SourceGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- RepoDB 1.17.0——官方包组合：Core + 三方言 provider + MySQL/PG 的 BulkOperations 扩展
         （SQLite 无 BulkOperations 包，批量走 Core 的 InsertAll/MergeAll；见 RepoDbArm.cs） -->
    <PackageReference Include="RepoDb" Version="1.17.0" />
    <PackageReference Include="RepoDb.Sqlite.Microsoft" Version="1.17.0" />
    <PackageReference Include="RepoDb.MySqlConnector" Version="1.17.0" />
    <PackageReference Include="RepoDb.PostgreSql" Version="1.17.0" />
    <PackageReference Include="RepoDb.MySqlConnector.BulkOperations" Version="1.17.0" />
    <PackageReference Include="RepoDb.PostgreSql.BulkOperations" Version="1.17.0" />

    <!-- FreeSql -->
    <PackageReference Include="FreeSql" Version="3.5.311" />
    <PackageReference Include="FreeSql.Provider.SqliteCore" Version="3.5.311" />
    <PackageReference Include="FreeSql.Provider.MySqlConnector" Version="3.5.311" />
    <PackageReference Include="FreeSql.Provider.PostgreSQL" Version="3.5.311" />
    
    <!-- 基础数据访问库 -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="2.6.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Dapper.AOT" Version="1.1.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>
</Project>
