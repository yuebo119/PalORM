<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA2007;CA1062;CA1031;S107;CA2100;S2077;CA1303;CA1305;S1215;PALORM005;CA1849;S6966;CA2213;S3903;IDE0055;S3776;S3267;S1481;CA1502;CA1852;S1144</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PalORM.Core\PalORM.Core.csproj" />
    <ProjectReference Include="..\..\src\PalORM.Sqlite\PalORM.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\PalORM.PostgreSql\PalORM.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\PalORM.MySql\PalORM.MySql.csproj" />
    <ProjectReference Include="..\..\src\PalORM.SourceGen\PalORM.SourceGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>
</Project>
