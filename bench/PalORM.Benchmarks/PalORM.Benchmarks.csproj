<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PalORM.Benchmarks</RootNamespace>
    <AssemblyName>PalORM.Benchmarks</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1303;CA2007;CA1062;CA1031;CA1515;CA1812;CA2100;CA1852;CA1816;S1450;S3971;S108;S1186;IDE0063;DAP043</NoWarn>
    <!-- 基准测试实体属性名=列名（Dapper 公平对照），PALORM002 [Column] 注解要求在此豁免 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- BenchmarkDotNet 需要反射——基准项目不是 AOT 目标 -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <!-- Dapper.AOT 拦截器需要启用命名空间 -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PalORM.Core\PalORM.Core.csproj" />
    <ProjectReference Include="..\..\src\PalORM.Sqlite\PalORM.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\PalORM.PostgreSql\PalORM.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\PalORM.MySql\PalORM.MySql.csproj" />
    <ProjectReference Include="..\..\src\PalORM.SourceGen\PalORM.SourceGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- v5.0 阶段 3.4：从 NuGet 0.15.8 改为本地 ProjectReference（fork 已支持 net11）。
         NuGet 0.15.8 在 .NET 11 preview SDK 下抛 NotRecognized 异常。
         本地 fork 位于 bench/BenchmarkDotNet（.gitignore 排除，不入仓库）。
         其他开发者需自行 clone BDN fork 到此目录。 -->
    <ProjectReference Include="..\BenchmarkDotNet\src\BenchmarkDotNet\BenchmarkDotNet.csproj" />
    <ProjectReference Include="..\BenchmarkDotNet\src\BenchmarkDotNet.Annotations\BenchmarkDotNet.Annotations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dapper 对照 -->
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
    <!-- 同类 micro-ORM 对照——Dapper 官方 benchmarks/ 同样多 ORM 对照 -->
    <PackageReference Include="RepoDb" />
    <PackageReference Include="RepoDb.Sqlite.Microsoft" />
  </ItemGroup>
</Project>
