<Project>
  <!-- bench 子树作用域（2026-09-26）：导入仓库根 Directory.Build.props 保持 TWE 等全局配置，
       再对本子树关闭 NuGet 审计（NuGetAudit）。
       为什么：NuGetAudit 默认开启后，restore 需要联网拉取漏洞数据；本机 NuGet 走 WinINET 系统代理，
       代理规则不覆盖命令行进程时 NU1900（漏洞数据获取失败）被根级 TreatWarningsAsErrors 提升为
       error——BenchmarkDotNet 自动生成工程（bench/*/bin/**/BenchmarkDotNet.Autogenerated.csproj）
       与 DapperSuite 的 BDN 构建全部被阻断，perf.sh full 步骤 1/3 失败（2026-09-26 基线重录实测）。
       范围取舍：仅 bench 量具与外部锚点子树关闭——包全部钉扎、版本由 perf.sh 编排，供应链审计
       面向产品包（src/test 保持 NuGetAudit 默认开启不受影响）。 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
