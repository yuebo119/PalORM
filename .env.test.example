# PalORM 测试凭据示例 —— 复制为 .env.test（gitignored）后填入真实值。
#
# 用法：
#   cp .env.test.example .env.test
#   编辑 .env.test 填入本地/CI 数据库凭据
#   source scripts/set-test-env.sh
#
# .env.test 中的变量会被 appsettings.test.json 的 ${VAR} 占位符引用。
# 凭据不进 git（见 .gitignore）；CI 通过 secret 注入同名环境变量。

# PostgreSQL 测试库
PALORM_PG_HOST=127.0.0.1
PALORM_PG_PORT=5432
PALORM_PG_USER=postgres
PALORM_PG_PASSWORD=change-me
PALORM_PG_DATABASE=postgres

# 完整连接串覆盖（可选）——直接设置此变量则忽略上面的 PALORM_PG_* 拆分项
# PALORM_PG_CONNECTION=Host=127.0.0.1;Port=5432;Username=postgres;Password=change-me;Database=postgres

# MySQL 测试库
PALORM_MYSQL_HOST=127.0.0.1
PALORM_MYSQL_PORT=3306
PALORM_MYSQL_USER=root
PALORM_MYSQL_PASSWORD=change-me
PALORM_MYSQL_DATABASE=mysql

# 完整连接串覆盖（可选）
# PALORM_MYSQL_CONNECTION=Server=127.0.0.1;Port=3306;User=root;Password=change-me;Database=mysql
