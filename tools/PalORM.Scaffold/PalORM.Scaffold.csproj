<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 仓库内部 CLI 通过 dotnet run 使用，尚未定义 NuGet Tool 发布契约。 -->
    <!-- CLI 工具无需本地化，连接字符串来自用户输入非注入 -->
    <!-- S6966/CA1849：CLI 工具的 Console.WriteLine 同步调用可接受（非高并发路径） -->
    <!-- IDE0028/IDE0061：CLI 程序风格保守，不强推集合表达式/表达式主体 -->
    <!-- CLI 程序风格保守，不强推集合表达式/表达式主体。CA1308：PG/MySQL 类型名小写是惯例，不强转大写 -->
    <!-- $(NoWarn) 保留 Directory.Build.props 的中央包管理误报抑制 -->
    <!-- IDE0055：TypeMapper 的 PG/MySQL 类型映射表风格统一（对齐驱动列声明格式） -->
    <NoWarn>$(NoWarn);CA1303;CA2100;CA1849;S6966;IDE0028;IDE0061;CA1308;IDE0078;S1135;CA1307;IDE0055</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- v5.0 阶段 5.3：三 Provider scaffold 支持，全部 Provider 包都引入 -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <!-- BLOB 反向工程端到端回归：SourceGen.Tests 消费 internal 的 TypeMapper/EntityGenerator -->
    <InternalsVisibleTo Include="PalORM.SourceGen.Tests" />
  </ItemGroup>

</Project>
