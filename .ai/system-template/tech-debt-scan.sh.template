#!/usr/bin/env bash
# 通用技术债扫描脚本模板
# 用法: bash scripts/tech-debt-scan.sh
# 按项目实际语言/工具链调整检查项。

set -euo pipefail

PASS=0
FAIL=0

check() {
    local name="$1"
    local result="$2"
    local count
    count=$(echo "$result" | grep -c . 2>/dev/null || true)

    if [ "$count" -gt 0 ]; then
        echo "FAIL  $name ($count 处)"
        echo "$result" | head -5 | sed 's/^/      /'
        FAIL=$((FAIL + 1))
    else
        echo "PASS  $name (0 处)"
        PASS=$((PASS + 1))
    fi
}

echo "═══════════════════════════════════════════"
echo " 技术债扫描 ($(date '+%Y-%m-%d %H:%M'))"
echo "═══════════════════════════════════════════"
echo ""

# ─── 按项目实际调整以下检查项 ───

check "1. TODO/HACK/FIXME 注释" \
    "$(grep -rnE '// TODO|// HACK|// FIXME' src/ --include='*.cs' 2>/dev/null | grep -v 'obj/\|bin/' || true)"

check "2. Console 输出在生产代码" \
    "$(grep -rn 'Console\.' src/ --include='*.cs' 2>/dev/null | grep -v 'obj/\|bin/' || true)"

check "3. 空 catch 块" \
    "$(grep -rn 'catch.*{}' src/ --include='*.cs' 2>/dev/null | grep -v 'obj/\|bin/' || true)"

check "4. 超长行 > 180" \
    "$(find src/ -name '*.cs' -not -path '*/obj/*' -not -path '*/bin/*' -exec awk 'length($0)>180 {print FILENAME":"NR}' {} \; 2>/dev/null || true)"

# ─── 汇总 ───
echo ""
echo "═══════════════════════════════════════════"
echo " 结果: $PASS 通过 / $FAIL 失败"
echo "═══════════════════════════════════════════"

[ "$FAIL" -gt 0 ] && exit 1 || exit 0
