{
  // PalORM 全局测试配置（git 跟踪）——结构化默认值与连接模板。
  //
  // 凭据卫生（重要）：
  //   - 本文件只存"非敏感"默认值与占位符模板；任何密码、token、真实连接串不写入此处。
  //   - 真实凭据通过 .env.test（gitignored）以环境变量方式覆盖；优先级：环境变量 > 本文件 > 报错。
  //   - 详见 scripts/set-test-env.sh 与 .env.test.example。
  //
  // 占位符语法（仅 ${VAR} 形式）：
  //   "${PALORM_PG_HOST}" 会被读取器替换为同名环境变量值；环境变量缺失时读取失败（显式报错，不静默回退）。
  //   嵌套 ${${A}} 不支持；普通字符串（无 ${} 包裹）原样返回。

  "ConnectionStrings": {
    // PostgreSQL 测试库模板——通过 .env.test 注入 PALORM_PG_* 系列变量。
    "PostgreSql": "Host=${PALORM_PG_HOST};Port=${PALORM_PG_PORT};Username=${PALORM_PG_USER};Password=${PALORM_PG_PASSWORD};Database=${PALORM_PG_DATABASE}",

    // MySQL 测试库模板。
    "MySql": "Server=${PALORM_MYSQL_HOST};Port=${PALORM_MYSQL_PORT};User=${PALORM_MYSQL_USER};Password=${PALORM_MYSQL_PASSWORD};Database=${PALORM_MYSQL_DATABASE}",

    // SQLite 内存库（无需凭据，固定值）。
    "Sqlite": "Data Source=:memory:"
  },

  // 默认连接参数——可在 DbOptions 构造时覆盖。
  "Defaults": {
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30,
    "MaxRetries": 3,
    "MaxPoolSize": 100
  },

  // PG 通知监听器测试配置（可选）。
  "Notification": {
    "ReconnectMaxAttempts": 5,
    "ReconnectBaseDelaySeconds": 1
  },

  // Scaffold CLI 默认命名空间（命令行 --namespace 可覆盖）。
  "Scaffold": {
    "DefaultNamespace": "Models"
  }
}
