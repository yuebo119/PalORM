<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ADO.NET Providers -->
  <ItemGroup>
    <!-- ITM-依赖升级(2026-09-10)：preview.7 → rc.1（与 SDK 11.0.100-rc.1 同轨对齐；.NET 11 GA 后切 stable）
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="11.0.0-preview.7.26381.103" /> -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.4.0" />
    <!-- v5.0 阶段 2.2：Npgsql 9.0.3→10.0.3。破坏性变更（date/time 默认映射 DateOnly/TimeOnly）
         仅影响 GetValue/ExecuteScalar 路径；RowFactoryEmitter 全部用 GetDateTime/GetFieldValue<T>，
         经源码核实 v10 仍返回 DateTime/TimeSpan，零代码改动。 -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- v5.0 阶段 2.1：MySqlConnector 2.4.0→2.6.1（含安全修复 GHSA-473q-m89c-ghf8）；
         现为 2.6.2（安全修复延续，README 驱动表同口径）。破坏性变更（State=Broken / DI 命名空间迁移）对本项目零影响（见调研报告）。 -->
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <!-- 基础依赖 (BCL 自带，无需 NuGet 引用) -->
  <!-- Microsoft.Extensions.Logging.Abstractions 已包含在 .NET 11 共享框架中 -->

  <!-- 源生成器 -->
  <ItemGroup>
    <!-- 2026-09-10 升 5.6.0→5.9.0（r21 依赖升级轮）：解析验证通过（nuget.org/dotnet-tools
         双源均可达，5.6.0 时"dotnet-tools 无 stable"的源约束已过时——packageSourceMapping
         现允许双源）。升级验证：SourceGen 188 测试（含 13 份快照字节级对比）+
         全量 -warnaserror 构建全绿。 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
  </ItemGroup>

  <!-- 测试 -->
  <ItemGroup>
    <PackageVersion Include="TUnit" Version="1.66.27" />
    <PackageVersion Include="TUnit.Assertions" Version="1.66.27" />
    <!-- v5.0 阶段 1.3：移除 Microsoft.NET.Test.Sdk——TUnit 1.x 走 MTP 模式，
         dotnet run 直接执行，不再需要 VSTest 桥接（dotnet test 入口）。 -->
  </ItemGroup>

  <!-- 基准 -->
  <ItemGroup>
    <!-- v5.0 阶段 3.4：BenchmarkDotNet 从 NuGet 0.15.8 改为本地 ProjectReference（fork 已支持 net11）。
         删除此处的 PackageVersion，避免 NuGet 把旧包带回来覆盖 ProjectReference。
         PalORM.Benchmarks.csproj 直接 ProjectReference 引用 bench/BenchmarkDotNet。 -->
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Dapper.AOT" Version="1.0.52" />
    <!-- 同类 micro-ORM 对照（Dapper 官方 benchmarks/ 同样多 ORM 对照）。
         RepoDb 主包 1.15.1 / Sqlite 1.15.0 是各自最新稳定版（RepoDb 发布节奏差异）。 -->
    <PackageVersion Include="RepoDb" Version="1.16.0" />
    <PackageVersion Include="RepoDb.Sqlite.Microsoft" Version="1.16.0" />
  </ItemGroup>

  <!-- 源生成器测试（Phase 2 启用） -->
  <!--
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
  </ItemGroup>
  -->

  <!-- 质量分析器（v3.0：CI 守护层——让 SonarLint IDE 报告与 CI 编译错误对齐） -->
  <ItemGroup>
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" />
  </ItemGroup>

  <!-- SourceLink（v5.0 发布管道：NuGet.org 包页源码链接 + F12 步入）。
       2026-08-15 升 8.0.0→10.0.400：源兼容性随本次全量升级验证（build 0 警告）。 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
</Project>
