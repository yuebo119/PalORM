<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ADO.NET Providers -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.3.6" />
    <PackageVersion Include="Npgsql" Version="9.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <!-- 基础依赖 (BCL 自带，无需 NuGet 引用) -->
  <!-- Microsoft.Extensions.Logging.Abstractions 已包含在 .NET 11 共享框架中 -->

  <!-- 源生成器 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <!-- v5.0 阶段 1.4：Analyzers 保持 5.3.0——5.6.0 在 NuGet.Config 配置的 dotnet-tools
         源里无 stable 发布（该源最接近版本是 5.7.0-prerelease）。回退避免 NU1103。
         packageSourceMapping 规定 Microsoft.CodeAnalysis.* 只从 dotnet-tools 取，
         不可改源（Microsoft.CodeAnalysis.CSharp net11 配套版只在 dnceng 内部源）。 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
  </ItemGroup>

  <!-- 测试 -->
  <ItemGroup>
    <PackageVersion Include="TUnit" Version="1.61.15" />
    <PackageVersion Include="TUnit.Assertions" Version="1.61.15" />
    <!-- v5.0 阶段 1.3：移除 Microsoft.NET.Test.Sdk——TUnit 1.x 走 MTP 模式，
         dotnet run 直接执行，不再需要 VSTest 桥接（dotnet test 入口）。 -->
  </ItemGroup>

  <!-- 基准 -->
  <ItemGroup>
    <!-- v5.0 阶段 1.5：基准工具升级到最新稳定版 -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Dapper.AOT" Version="1.0.52" />
    <!-- 同类 micro-ORM 对照（Dapper 官方 benchmarks/ 同样多 ORM 对照）。
         RepoDb 主包 1.15.1 / Sqlite 1.15.0 是各自最新稳定版（RepoDb 发布节奏差异）。 -->
    <PackageVersion Include="RepoDb" Version="1.15.1" />
    <PackageVersion Include="RepoDb.Sqlite.Microsoft" Version="1.15.0" />
  </ItemGroup>

  <!-- 源生成器测试（Phase 2 启用） -->
  <!--
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
  </ItemGroup>
  -->

  <!-- 质量分析器（v3.0：CI 守护层——让 SonarLint IDE 报告与 CI 编译错误对齐） -->
  <ItemGroup>
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.29.0.143774" />
  </ItemGroup>
</Project>
