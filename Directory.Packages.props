<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ADO.NET Providers -->
  <ItemGroup>
    <!-- net10 分支（2026-10-24）：11.0.0-rc.2.26504.105 → 10 线 stable。LTS 分支不应依赖
         net11 预览线驱动包；net10.0 目标下 10 线 stable 为同线正式版（主线 net11.0 目标
         不适用 10 线 stable，故主线维持 rc.2 与 SDK 同轨）。 -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <!-- 2026-10-14 依赖升级轮：SQLite3MC 2.4.0→2.6.1（引擎升 SQLite 3.54.0；chacha20/poly1305
         硬件加速、临时文件加密与新 pragma，与本仓使用面（Batteries_V2.Init + 标准 SQL）零交集，
         无初始化 API 变更）。2026-10-19 复核：2.6.1 仍为最新稳定版。 -->
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.6.1" />
    <!-- v5.0 阶段 2.2：Npgsql 9.0.3→10.0.3。破坏性变更（date/time 默认映射 DateOnly/TimeOnly）
         仅影响 GetValue/ExecuteScalar 路径；RowFactoryEmitter 全部用 GetDateTime/GetFieldValue<T>，
         经源码核实 v10 仍返回 DateTime/TimeSpan，零代码改动。 -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- v5.0 阶段 2.1：MySqlConnector 2.4.0→2.6.1（含安全修复 GHSA-473q-m89c-ghf8）；
         现为 2.6.2（安全修复延续，README 驱动表同口径）。破坏性变更（State=Broken / DI 命名空间迁移）对本项目零影响（见调研报告）。 -->
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <!-- 基础依赖 (BCL 自带，无需 NuGet 引用) -->
  <!-- Microsoft.Extensions.Logging.Abstractions 已包含在 .NET 11 共享框架中 -->

  <!-- 源生成器 -->
  <ItemGroup>
    <!-- 2026-09-10 升 5.6.0→5.9.0（r21 依赖升级轮）：解析验证通过（nuget.org/dotnet-tools
         双源均可达，5.6.0 时"dotnet-tools 无 stable"的源约束已过时——packageSourceMapping
         现允许双源）。升级验证：SourceGen 188 测试（含 13 份快照字节级对比）+
         全量 -warnaserror 构建全绿。 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- 2026-10-19 复核：5.9.0 为最新稳定版；NuGet 上 5.13.0-1.26516.101 为预览版，
         分析器与 SDK 编译器版本兼容优先，不采用预览。 -->
  </ItemGroup>

  <!-- 测试 -->
  <ItemGroup>
    <!-- 2026-09-29 依赖升级轮：1.69.0→1.71.0（minor，测试框架）——升后三测试套全量验证。
         2026-10-08 依赖升级轮：1.71.0→1.73.5（minor，测试框架）——升后 ci.slnf 构建 + 三测试套全量验证。
         2026-10-11 依赖升级轮：1.73.5→1.73.19（patch 流，测试框架）——升后 ci.slnf 构建 + 三测试套全量验证。
         2026-10-14 依赖升级轮：1.73.19→1.74.0（minor，测试框架）——升后 ci.slnf 构建 + 三测试套全量验证。
         2026-10-19 依赖升级轮：1.74.0→1.75.0（minor，测试框架）——升后 ci.slnf 构建 + 三测试套全量验证。 -->
    <!-- 2026-10-22 依赖升级轮：1.75.0→1.76.0（minor，测试框架）——升后 ci.slnf 构建 + 三测试套全量验证。 -->
    <PackageVersion Include="TUnit" Version="1.76.0" />
    <PackageVersion Include="TUnit.Assertions" Version="1.76.0" />
    <!-- v5.0 阶段 1.3：移除 Microsoft.NET.Test.Sdk——TUnit 1.x 走 MTP 模式，
         dotnet run 直接执行，不再需要 VSTest 桥接（dotnet test 入口）。 -->
  </ItemGroup>

  <!-- 基准 -->
  <ItemGroup>
    <!-- v5.0 阶段 3.4：BenchmarkDotNet 从 NuGet 0.15.8 改为本地 ProjectReference（fork 已支持 net11）。
         删除此处的 PackageVersion，避免 NuGet 把旧包带回来覆盖 ProjectReference。
         PalORM.Benchmarks.csproj 直接 ProjectReference 引用 bench/BenchmarkDotNet。 -->
    <!-- 2026-09-24 依赖升级轮：Dapper 2.1.79→2.1.89（patch）、Dapper.AOT 1.0.52→1.1.0（minor）。
         口径注记：Dapper 是三臂对照的外部锚点——版本变化会让 PerfHub/DapperSuite 的 Dapper 臂数字
         与历史批次漂移，下次全量跑测起 P/Dapper 列跨批不直接可比（批内三臂仍同批可比）。 -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Dapper.AOT" Version="1.1.0" />
    <!-- 同类 micro-ORM 对照（Dapper 官方 benchmarks/ 同样多 ORM 对照）。
         2026-10-23 依赖升级轮：1.16.0→1.17.0（minor，两包同版本号）——新增 DuckDB/CockroachDB/
         AuroraDB/Turso/Ahtola 提供者与 NativeAOT 兼容；本仓只用 Sqlite.Microsoft 的基础
         Query/QueryAll/Insert，无属性处理器与批量 API 依赖。
         口径注记：RepoDb 是对照臂外部锚点，升级后 BDN 历史批次的 RepoDb 列跨批不直接可比
         （批内三臂仍同批可比），与 Dapper 版本变更同口径。 -->
    <PackageVersion Include="RepoDb" Version="1.17.0" />
    <PackageVersion Include="RepoDb.Sqlite.Microsoft" Version="1.17.0" />
  </ItemGroup>

  <!-- 源生成器测试（Phase 2 启用） -->
  <!--
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
  </ItemGroup>
  -->

  <!-- 质量分析器（v3.0：CI 守护层——让 SonarLint IDE 报告与 CI 编译错误对齐） -->
  <ItemGroup>
    <!-- 2026-09-29 依赖升级轮：10.34.0.3385→10.35.0.4138——升后 ci.slnf 严格构建全绿。 -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>

  <!-- SourceLink（v5.0 发布管道：NuGet.org 包页源码链接 + F12 步入）。
       2026-08-15 升 8.0.0→10.0.400：源兼容性随本次全量升级验证（build 0 警告）。 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <!-- 2026-10-19 复核：10.0.402 为最新稳定版；11.0.100-rc.2 属 SDK 预览线，不采用。 -->
  </ItemGroup>

  <!-- 传递依赖稳定版固定（CentralPackageTransitivePinningEnabled）——2026-10-19 依赖升级轮：
       `dotnet list package` 的 outdated/transitive 模式报出的可升稳定版；
       System.* 10.0.x / SourceLink 依赖与 Roslyn 5.9 同线，ApplicationInsights 3.x 为 TUnit 测试依赖的
       最新稳定版。预览线（System.IO.Hashing 11-rc、Roslyn 5.13-preview、Testing 3.2-preview、
       DiaSymReader 12-alpha）不采用。 -->
  <ItemGroup>
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.13" />
    <PackageVersion Include="System.Reflection.Metadata" Version="10.0.13" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="7.0.4" />
    <PackageVersion Include="Microsoft.DiaSymReader" Version="2.2.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.13" />
    <PackageVersion Include="Microsoft.ApplicationInsights" Version="3.2.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <!-- net10 分支：Extensions 抽象不在 net10.0 共享框架（net11 起才并入 NETCore.App），
         Core 的 ILogger/ILoggerFactory 依赖须显式补 Abstractions 包（net11 主线无需）。 -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <!-- 2026-10-20 依赖复核：4.91.0→4.91.1（patch）。上游=Azure.Core 1.63.0（经
         Microsoft.ApplicationInsights 进入测试项目），仅测试图可见，产品包不受影响。 -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.1" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <!-- 2026-10-22 依赖升级轮：OpenTelemetry 1.20.0→1.20.1、PersistentStorage 1.1.2→1.1.3（patch）。 -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.Abstractions" Version="1.1.3" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.FileSystem" Version="1.1.3" />
    <PackageVersion Include="System.Memory.Data" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>
</Project>
