<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PalORM.PackageConsumer.Aot</RootNamespace>
    <AssemblyName>PalORM.PackageConsumer.Aot</AssemblyName>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- 同 PalORM.AotTest：测试程序无 XML 文档需求，且绕开 rc.2 发布 DocFileItem 的 MSB3030。 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PalORM.Core" Version="6.8.0" />
    <PackageReference Include="PalORM.Sqlite" Version="6.8.0" />
    <PackageReference Include="PalORM.SourceGen" Version="6.8.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
