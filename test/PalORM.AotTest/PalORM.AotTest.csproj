<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PalORM.AotTest</RootNamespace>
    <AssemblyName>PalORM.AotTest</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- 测试可执行程序无需 XML 文档；且 rc.2 SDK 的发布目标会把 DocFileItem 从 RID 输出目录
         复制，而 AOT 流程的构建产物落在非 RID 目录 → MSB3030（2026-10-17 CI 实证，四个 AOT
         job 全挂）。关闭生成即无 DocFileItem，绕开该路径；src/ 的文档强制不受影响。 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PalORM.Core\PalORM.Core.csproj" />
    <ProjectReference Include="..\..\src\PalORM.Sqlite\PalORM.Sqlite.csproj" />
    <ProjectReference Include="..\PalORM.AotModels.First\PalORM.AotModels.First.csproj" />
    <ProjectReference Include="..\PalORM.AotModels.Second\PalORM.AotModels.Second.csproj" />
    <ProjectReference Include="..\..\src\PalORM.SourceGen\PalORM.SourceGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
