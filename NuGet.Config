<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- M2-8（独立审计 D2）：Roslyn 只从 nuget.org 取（单一可审计来源）——dotnet-tools 是
         可变公共 feed，版本虽已钉住（5.9.0）无漂移，但分析器 DLL 的来源应唯一。
         G32 语义不变：nuget.org 仍可为约束包供货；dotnet-tools 源保留（无 pattern 即不可供）。 -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- bench/BenchmarkDotNet fork 自带 NuGet.Config 以 <clear/> 重定义源（键名 api.nuget.org），
         而源映射按"源键"匹配——键名不同则 NU1100（fork 的 net8/net9 多目标引用包解析失败）。
         此处为 fork 的键补通配映射（与 nuget.org 同一源，G32 语义不变）。 -->
    <packageSource key="api.nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- vendored fork 的 BenchmarkDotNet.Weaver 是本地 pack 产物（src/BenchmarkDotNet.Weaver/packages，
         不在任何公共源上）。映射按源键匹配——本地 feed 键无 pattern 即"未考虑"，冷缓存下
         BDN job exe 的 DllGatherer 还原必然 NU1101（2026-10-17 全量批实测：BDN 零执行假绿）。
         精确 pattern 优先于 * 通配，nuget.org/api.nuget.org 的供货面不变（G32 语义不变）。 -->
    <packageSource key="benchmarkdotnet.weaver">
      <package pattern="BenchmarkDotNet.Weaver" />
    </packageSource>
  </packageSourceMapping>
</configuration>
