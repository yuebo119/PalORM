<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <!-- 不使用 packageSourceMapping：
       dotnet-tools 源只承载 .NET SDK 内部预览版（如 Roslyn 5.7.0-1.26181.1），
       而源生成器依赖 Roslyn 稳定版（5.6.0/5.3.0 发布在 nuget.org）。
       若对 Microsoft.CodeAnalysis.* 做 dotnet-tools 映射，NuGet 严格遵守 mapping
       不回退 nuget.org，导致 restore 报 NU1103（CI #c6bbecd 起失败）。 -->
</configuration>
