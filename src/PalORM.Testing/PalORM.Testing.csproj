<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PalORM.Testing</RootNamespace>
    <AssemblyName>PalORM.Testing</AssemblyName>
    <Description>PalORM 内部测试工具库（不发布到 NuGet）— 供 PalORM.Integration.Tests 引用，构造测试数据库连接</Description>
    <!-- 不发布到 nuget.org：此库仅 PalORM 自身集成测试用，不是面向最终用户的公共 API。
         Version/SourceLink 仍继承自 Directory.Build.props（ProjectReference 内部消费用）。 -->
    <IsPackable>false</IsPackable>
    <PackageTags>ORM;Testing;AOT;micro-ORM</PackageTags>
    <!-- Version 由 Directory.Build.props 集中管理 -->
    <NoWarn>$(NoWarn);CA2007;NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试需覆盖两个纯函数内部件：ParseDotEnv（.env.test 解析）与 FindFileUpwards（向上回溯深度）。
         后者是"尾部分隔符偷走一次迭代"这一差一错误的唯一可锁定入口——只按公开行为测不出来
         （输出目录层级有余量时两种实现都能找到文件）。 -->
    <InternalsVisibleTo Include="PalORM.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PalORM.Core\PalORM.Core.csproj" />
    <ProjectReference Include="..\PalORM.Sqlite\PalORM.Sqlite.csproj" />
    <ProjectReference Include="..\PalORM.PostgreSql\PalORM.PostgreSql.csproj" />
    <ProjectReference Include="..\PalORM.MySql\PalORM.MySql.csproj" />
  </ItemGroup>
</Project>
