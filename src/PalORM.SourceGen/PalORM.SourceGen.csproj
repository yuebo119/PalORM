<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PalORM.SourceGen</RootNamespace>
    <AssemblyName>PalORM.SourceGen</AssemblyName>
    <Description>PalORM 源生成器 — IIncrementalGenerator, RowFactory, CommandFactory, SqlFile</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <IsPublishable>false</IsPublishable>
    <_IsPublishable Condition="'$(PublishAot)' == 'true'">false</_IsPublishable>

    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
    <!-- ITM-530：RS1035（源生成器禁用 IO API）不再全局抑制，改为 SqlFileEmitter 里
         File.ReadAllText 处局部 #pragma，避免掩蔽其它意外的 IO 使用 -->
    <NoWarn>$(NoWarn);CS1591;RS2008</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageTags>ORM;AOT;source-generator;analyzer;sqlfile</PackageTags>
    <!-- Version 由 Directory.Build.props 集中管理 -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PalORM.SourceGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- SourceLink：PrivateAssets=all。SourceGen 跑在 netstandard2.0+Roslyn 分析器上下文，
       SourceLink 是 build-time target 包（不进 analyzer load 路径），无 RS1036 风险。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
</Project>
