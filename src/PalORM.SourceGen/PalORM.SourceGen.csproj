<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PalORM.SourceGen</RootNamespace>
    <AssemblyName>PalORM.SourceGen</AssemblyName>
    <Description>PalORM 源生成器 — IIncrementalGenerator, RowFactory, CommandFactory, SqlFile</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <IsPublishable>false</IsPublishable>
    <_IsPublishable Condition="'$(PublishAot)' == 'true'">false</_IsPublishable>

    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
    <!-- ITM-530：RS1035（源生成器禁用 IO API）。评审 2026-09-02 第二批：SqlFile 重构后
         生成器零磁盘 IO（.sql 内容经 AdditionalTexts 进增量管线），全项目无 RS1035 抑制；
         未来新增 IO 使用必须转为管线输入而非读盘 -->
    <NoWarn>$(NoWarn);CS1591;RS2008</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageTags>ORM;AOT;source-generator;analyzer;sqlfile</PackageTags>
    <!-- Version 由 Directory.Build.props 集中管理 -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PalORM.SourceGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- v5.1：Auto Tagging Interceptor 的 buildTransitive targets——
         消费侧设 <PalORMAutoTagging>true</PalORMAutoTagging> 后自动注入 Interceptors 配置 -->
    <None Include="buildTransitive\**\*.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <!-- SourceLink：PrivateAssets=all。SourceGen 跑在 netstandard2.0+Roslyn 分析器上下文，
       SourceLink 是 build-time target 包（不进 analyzer load 路径），无 RS1036 风险。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
</Project>
