<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PalORM.MySql</RootNamespace>
    <AssemblyName>PalORM.MySql</AssemblyName>
    <Description>PalORM MySQL Provider — MySqlConnector 适配</Description>
    <PackageTags>ORM;MySQL;MySqlConnector;AOT;micro-ORM</PackageTags>
    <!-- Version 由 Directory.Build.props 集中管理 -->
    <NoWarn>$(NoWarn);CA2100;CA2007;NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PalORM.Core\PalORM.Core.csproj" />
    <!-- EntityDataReader（internal）的 DbDataReader 契约需要确定性单测覆盖：
         只靠真库集成用例时，服务端 local_infile=OFF 会让 provider 静默回退多值 INSERT，
         该用例就不再经过读取器——测试通过但什么都没验证。 -->
    <InternalsVisibleTo Include="PalORM.Core.Tests" />
    <!-- 2026-10-18 审计：真库用例需要 ResetLocalInfileProbeCache() 清理探测缓存——
         SET GLOBAL local_infile 恢复后缓存仍持旧值至 TTL 到期，BulkCopy 路径集成覆盖率
         长期为 0%（用例通过但未验证目标路径）。 -->
    <InternalsVisibleTo Include="PalORM.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
</Project>
